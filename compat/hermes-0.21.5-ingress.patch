diff --git a/gateway/ingress.py b/gateway/ingress.py
new file mode 100644
index 000000000..af28e081b
--- /dev/null
+++ b/gateway/ingress.py
@@ -0,0 +1,151 @@
+"""Optional, platform-neutral reply policies before the gateway's busy/steer boundary.
+
+Policies receive immutable bounded text. Hermes retains authorization, control routing,
+ordering and transcript ownership. Register through PluginContext.register_ingress_policy.
+"""
+import asyncio
+from dataclasses import dataclass
+import logging
+
+from gateway.ingress_store import IngressMessage, UnsettledObservation, observe, read_snapshot
+from gateway.platforms.event import MessageType
+from gateway.session_identity import replace_source
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class IngressRequest:
+    platform: str
+    chat_id: str
+    session_key: str
+    message_id: str
+    text: str
+    history: tuple[IngressMessage, ...]
+    reply_expected: bool | None
+
+
+def pending_control(runner, key):
+    """Any unknown control state bypasses policy, just like a known pending prompt."""
+    try:
+        from tools import clarify_gateway, slash_confirm
+        from tools.approval import has_blocking_approval
+        state = runner._peek_session_state(key)
+        return bool((state and state.persistent.update_prompt_pending)
+                    or clarify_gateway.get_pending_for_session(key, include_choice_prompts=True)
+                    or slash_confirm.get_pending(key) or has_blocking_approval(key))
+    except Exception:
+        return True
+
+
+from gateway.ingress_queue import IngressQueue
+
+
+def has_policy(event):
+    """Read the already-loaded registry under canonical runtime ownership; never discover here."""
+    from gateway.session_identity import identity_of
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from hermes_cli.plugins import iter_hook_callbacks
+    identity = identity_of(event.source)
+    if identity is None:
+        return False
+    token = set_hermes_home_override(identity.runtime_home)
+    try:
+        return bool(iter_hook_callbacks('pre_gateway_ingress'))
+    finally:
+        reset_hermes_home_override(token)
+
+
+async def authorized(runner, event):
+    """Full canonical authorization before accepting recoverable ingress ownership."""
+    author = event.user_id or event.source.user_id
+    if not author:
+        return False
+    source = replace_source(event.source, user_id=author,
+                            user_name=event.user_name or event.source.user_name)
+    async with runner._async_profile_scope_for_source(event.source):
+        return await asyncio.to_thread(runner._is_user_authorized_for_source, source)
+
+
+async def _decision(runner, event, key, previous):
+    """True only when Hermes durably owns an observation; ordinary errors fail open."""
+    if (event.message_type != MessageType.TEXT or event.media_urls or event.prompt_response
+            or event.reply_expected is not False or event.reply_to_is_own_message
+            or not event.message_id or not event.text or len(event.text) > 6000):
+        return False
+    async with runner._async_profile_scope_for_source(event.source):
+        from hermes_cli.plugins import iter_hook_callbacks
+        callbacks = iter_hook_callbacks('pre_gateway_ingress')
+        # Several independent suppression policies cannot compose safely by accident.
+        if len(callbacks) != 1 or pending_control(runner, key):
+            return False
+        if previous is None and runner._is_session_running(key):
+            return False  # startup/eviction: active input may not have reached the transcript
+        author = event.user_id or event.source.user_id
+        if not author:
+            return False
+        source = replace_source(event.source, user_id=author, user_name=event.user_name or event.source.user_name)
+        if not await asyncio.to_thread(runner._is_user_authorized_for_source, source):
+            return False  # normal authorization remains responsible for rejection/UX
+        try:
+            snapshot = await asyncio.wait_for(asyncio.to_thread(
+                read_snapshot, runner.session_store, key, required_message_id=previous,
+                message_id=event.message_id), timeout=0.5)
+        except Exception:
+            return False
+        if snapshot is None:
+            return False
+        if snapshot.already_observed:
+            return (snapshot, None, None)
+        text = event.text
+        prefix = f'[{event.user_name or event.source.user_name or author}|{author}]\n'
+        if not text.startswith(prefix):
+            text = prefix + text
+        request = IngressRequest(event.source.platform.value, event.source.chat_id, key,
+                                 event.message_id, text, snapshot.history, event.reply_expected)
+        try:
+            result = await asyncio.wait_for(callbacks[0](request), timeout=2.0)
+        except Exception:
+            logger.debug('Ingress policy unavailable; continuing normal dispatch')
+            return False
+        if not isinstance(result, dict) or result.get('action') != 'observe':
+            return False
+        if pending_control(runner, key):
+            return False
+        if callbacks != iter_hook_callbacks('pre_gateway_ingress'):
+            return False  # unload/reload while request was in flight
+        if not await asyncio.to_thread(runner._is_user_authorized_for_source, source):
+            return False
+        guard = result.get("commit_guard")
+        if guard is not None and not callable(guard):
+            return False
+        def still_current():
+            return (callbacks == iter_hook_callbacks("pre_gateway_ingress")
+                    and not pending_control(runner, key)
+                    and (guard is None or guard() is True))
+        return snapshot, text, still_current
+
+
+async def evaluate(runner, event, key, previous, deadline=None):
+    """Classification expires on arrival budget; a started write always settles first."""
+    deadline = deadline if deadline is not None else asyncio.get_running_loop().time() + 1.0
+    try:
+        async with asyncio.timeout_at(deadline):
+            decision = await _decision(runner, event, key, previous)
+    except TimeoutError:
+        return False
+    if not decision:
+        return False
+    snapshot, text, guard = decision
+    if text is None:
+        return True
+    async with runner._async_profile_scope_for_source(event.source):
+        write = asyncio.create_task(asyncio.to_thread(observe, runner.session_store, snapshot,
+                                                     event.message_id, text, commit_guard=guard))
+        try:
+            return await asyncio.shield(write)
+        except asyncio.CancelledError:
+            try:
+                await asyncio.shield(write)
+            finally:
+                raise
diff --git a/gateway/ingress_queue.py b/gateway/ingress_queue.py
new file mode 100644
index 000000000..1728f1b1b
--- /dev/null
+++ b/gateway/ingress_queue.py
@@ -0,0 +1,190 @@
+"""Transient ordered admission lanes; durable recovery uses Hermes's existing pending spool."""
+import asyncio
+from collections import OrderedDict
+from dataclasses import dataclass
+import logging
+import time
+
+from gateway.ingress_store import UnsettledObservation
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class _OwnedInput:
+    key: str
+    event: object
+    arrival_order: int = 0
+    authorized: bool = True
+    settled: bool = False
+    discarded: bool = False
+    retaining: bool = False
+
+
+@dataclass
+class _Admission:
+    lock: object
+    references: int = 0
+    generation: int = 0
+
+
+class IngressQueue:
+    """Own accepted inputs until observation, normal admission, or recovery spool settles.
+
+    Commands bypass classification; reset commands explicitly discard older queued work.
+    At capacity ordinary intake applies backpressure instead of overtaking an older lane.
+    The one-second classification budget starts on arrival, including predecessor waits.
+    """
+    MAX_PENDING = 128
+    BUDGET_SECONDS = 1.0
+
+    def __init__(self, adapter, policy, *, enabled=None, bypass=None, authorize=None):
+        self.adapter, self.policy = adapter, policy
+        self.enabled, self.bypass, self.authorize = enabled, bypass, authorize
+        self.tasks, self.owned, self.admissions = {}, {}, {}
+        self.previous = OrderedDict()
+        self.closing = False
+
+    async def submit(self, event, key):
+        if event.internal or event.is_command():
+            from hermes_cli.commands import is_interrupt_then_dispatch
+            if is_interrupt_then_dispatch(event.get_command()):
+                admission = self.admissions.get(key)
+                if admission is not None:
+                    admission.generation += 1
+                for task in tuple(self.tasks.get(key, ())):
+                    self.owned[task].discarded = True
+                    task.cancel()
+                self.previous.pop(key, None)
+            return False
+        if self.closing:
+            return False
+        enabled = self.enabled is None or self.enabled(event)
+        if not enabled and key not in self.tasks:
+            return False
+        if self.bypass is not None and self.bypass(event, key):
+            self.previous[key] = ''  # a control response overtook this lane: its context is unknown
+            return False
+        if event.source.chat_type not in {'group', 'channel', 'thread'}:
+            return False
+        deadline = asyncio.get_running_loop().time() + self.BUDGET_SECONDS
+        arrival_order = time.time_ns()
+        admission = self.admissions.setdefault(key, _Admission(asyncio.Lock()))
+        admission.references += 1
+        generation = admission.generation
+        try:
+            async with admission.lock:
+                return await self._admit(event, key, enabled, deadline, admission, generation, arrival_order)
+        finally:
+            admission.references -= 1
+            if admission.references == 0:
+                self.admissions.pop(key, None)
+
+    async def _admit(self, event, key, enabled, deadline, admission, generation, arrival_order):
+        authorized = True
+        if self.authorize is not None:
+            try:
+                async with asyncio.timeout_at(deadline):
+                    if not await self.authorize(event):
+                        return False
+            except TimeoutError:
+                enabled = authorized = False  # dispatch in order; no policy or transcript recovery
+        # Bounded host ownership. Existing decisions have the same arrival deadline, so
+        # saturation sheds classification work as deadlines expire, preserving FIFO dispatch.
+        while len(self.owned) >= self.MAX_PENDING:
+            running = [t for t in self.owned if not t.done()]
+            if not running:
+                return False  # storage failure: preserve older inputs, do not keep classifying
+            await asyncio.wait(running, return_when=asyncio.FIRST_COMPLETED)
+            await asyncio.sleep(0)  # completed-task ownership callbacks run before rechecking
+        lane = self.tasks.setdefault(key, [])
+        predecessor = lane[-1] if lane else None
+        if admission.generation != generation:
+            event._gateway_accepted = True  # explicit reset discarded this pre-reset input
+            return True
+        item = _OwnedInput(key, event, arrival_order, authorized)
+        task = asyncio.create_task(self._work(item, predecessor, enabled, deadline), name='gateway-ingress')
+        self.owned[task] = item
+        lane.append(task)
+        self.adapter._background_tasks.add(task)
+        task.add_done_callback(self._done)
+        event._gateway_accepted = True
+        return True
+
+    async def _work(self, item, predecessor, enabled, deadline):
+        event, key = item.event, item.key
+        try:
+            if predecessor is not None:
+                try:
+                    await asyncio.shield(predecessor)
+                except asyncio.CancelledError:
+                    if asyncio.current_task().cancelling():
+                        raise
+                except Exception:
+                    # The predecessor retains its own recovery receipt; successors remain
+                    # recoverable too, rather than being silently lost or sent out of order.
+                    raise UnsettledObservation('predecessor admission unresolved') from None
+            previous = self.previous.get(key)
+            handled = False
+            if enabled and previous != '' and asyncio.get_running_loop().time() < deadline:
+                try:
+                    handled = await self.policy(event, key, previous, deadline)
+                except (asyncio.CancelledError, UnsettledObservation):
+                    raise
+                except Exception:
+                    logger.warning('Ingress policy failed; continuing normal dispatch')
+            if handled:
+                item.settled = True
+                return
+            self.previous[key] = event.message_id or ''
+            self.previous.move_to_end(key)
+            while len(self.previous) > self.MAX_PENDING:
+                self.previous.popitem(last=False)
+            # The ingress receipt is not a receipt from the next owner.
+            event._gateway_accepted = False
+            await self.adapter._dispatch_admitted_message(event, key)
+            item.settled = event._gateway_accepted is True
+        finally:
+            # Also runs on cancellation mid-evaluation. A task cancelled before first entry
+            # is handled by _done / shutdown, where the owned record already exists.
+            if not item.settled and not item.discarded:
+                await asyncio.shield(self._retain(item))
+
+    async def _retain(self, item):
+        if item.settled or item.discarded or item.retaining:
+            return
+        item.retaining = True
+        try:
+            from gateway.shutdown_flush import flush_pending_to_file
+            payload = {'text': item.event.text, 'message_id': item.event.message_id,
+                       'ingress_order': item.arrival_order, 'ingress_authorized': item.authorized}
+            saved = await asyncio.to_thread(flush_pending_to_file, {item.key: payload}, reason='ingress_unsettled')
+            item.settled = saved == 1
+            if not item.settled:
+                logger.error('Could not preserve pending ingress input')
+        finally:
+            item.retaining = False
+
+    def _done(self, task):
+        self.adapter._background_tasks.discard(task)
+        item = self.owned.get(task)
+        if item is None:
+            return
+        lane = self.tasks.get(item.key, [])
+        if task in lane:
+            lane.remove(task)
+        if not lane:
+            self.tasks.pop(item.key, None)
+        if not task.cancelled() and task.exception() is not None:
+            logger.error('Ingress admission deferred to recovery')
+            self.previous[item.key] = ''
+        if item.settled or item.discarded:
+            self.owned.pop(task, None)
+
+    async def preserve_pending(self):
+        """Called by adapter shutdown after cancelling workers, before releasing ownership."""
+        self.closing = True
+        for task, item in list(self.owned.items()):
+            await self._retain(item)
+            if item.settled or item.discarded:
+                self.owned.pop(task, None)
diff --git a/gateway/ingress_store.py b/gateway/ingress_store.py
new file mode 100644
index 000000000..821b27e39
--- /dev/null
+++ b/gateway/ingress_store.py
@@ -0,0 +1,158 @@
+"""Bounded read-only ingress context and idempotent transcript ownership.
+
+Run off the event loop. No ordinary transcript retry queue is involved: returning
+False means the caller may dispatch; an uncertain write raises and requires recovery.
+"""
+from dataclasses import dataclass
+import time
+from agent.message_metadata import stamp_message_uid
+from hermes_state_messages import _INSERT_MESSAGE_SQL
+
+
+@dataclass(frozen=True)
+class IngressMessage:
+    role: str
+    content: str
+
+
+@dataclass(frozen=True)
+class Snapshot:
+    session_key: str
+    session_id: str
+    history: tuple[IngressMessage, ...]
+    already_observed: bool = False
+
+
+class UnsettledObservation(RuntimeError):
+    """Storage cannot confirm ownership. Preserve the input; do not dispatch it twice."""
+
+
+def _current(store, key, sid=None):
+    # No loading or I/O under shared locks. Unloaded/contended state means allow.
+    if not store._lock.acquire(blocking=False):
+        return None
+    try:
+        entry = store._entries.get(key)
+        if entry is None or entry.suspended or (sid is not None and entry.session_id != sid):
+            return None
+        candidate = entry.session_id
+    finally:
+        store._lock.release()
+    lock = store._get_transcript_drain_lock()
+    if not lock.acquire(blocking=False):
+        return None
+    try:
+        if store._dirty_transcripts.get(candidate) or store._follow_reroutes(candidate) != candidate:
+            return None
+    finally:
+        lock.release()
+    return candidate
+
+
+def _existing(conn, sid, message_id):
+    row = conn.execute('SELECT observed FROM messages WHERE session_id=? AND platform_message_id=? LIMIT 1',
+                       (sid, message_id)).fetchone()
+    return bool(row[0]) if row else None
+
+
+def read_snapshot(store, session_key, *, required_message_id=None, message_id=None):
+    sid = _current(store, session_key)
+    if sid is None:
+        return None
+    db = store._db_for_key(session_key)
+    if db is None:
+        return None
+    with db._read_ctx() as conn:
+        session = conn.execute('SELECT end_reason FROM sessions WHERE id=?', (sid,)).fetchone()
+        if session is None or session[0] is not None:
+            return None
+        if required_message_id and not conn.execute(
+            'SELECT 1 FROM messages WHERE session_id=? AND platform_message_id=? LIMIT 1',
+            (sid, required_message_id)).fetchone():
+            return None
+        duplicate = _existing(conn, sid, message_id) if message_id else None
+        rows = conn.execute(
+            "SELECT role, length(content), CASE WHEN length(content)<=6000 THEN content END "
+            "FROM messages WHERE session_id=? AND (platform_message_id IS NULL OR platform_message_id != ?) "
+            "AND active=1 AND role IN ('user','assistant') AND typeof(content)='text' "
+            "AND (display_kind IS NULL OR display_kind NOT IN ('hidden','session_meta')) "
+            "ORDER BY id DESC LIMIT 12", (sid, message_id or '')).fetchall()
+    history, remaining = [], 6000
+    for role, size, content in rows:
+        if size > remaining:
+            if not history:
+                return None  # no complete most-recent entry: insufficient context
+            break
+        if content:
+            history.append(IngressMessage(role, content))
+            remaining -= size
+    if _current(store, session_key, sid) is None:
+        return None
+    return Snapshot(session_key, sid, tuple(reversed(history)), duplicate is True)
+
+
+def _insert(db, conn, sid, message_id, text, *, observed, timestamp=None):
+    message = {'role': 'user', 'content': text, 'observed': observed,
+               'platform_message_id': message_id,
+               'display_metadata': {'ingress_observation': True} if observed else None}
+    stamp_message_uid(message)
+    params = db._message_row_params(sid, 'user', message, None, timestamp or time.time(), keep_reasoning=False)
+    db._check_transcript_write_guards(conn, sid, None)
+    conn.execute(_INSERT_MESSAGE_SQL, params)
+    db._bump_session_counters(conn, sid, 1, 0, unit=True)
+
+
+def observe(store, snapshot, message_id, text, *, commit_guard=None):
+    """Settle observation once. No write or retry is left behind after False.
+
+    Acquire the SQLite writer before validating the current routing generation. An
+    observation admitted there precedes a later reset; resets already published reject
+    it. Do not hold store/drain locks during disk I/O or SQLite lock retries.
+    """
+    if not message_id or _current(store, snapshot.session_key, snapshot.session_id) is None:
+        return False
+    sid = snapshot.session_id
+    db = store._db_for_key(snapshot.session_key)
+    if db is None:
+        return False
+    def write(conn):
+        saved = _existing(conn, sid, message_id)
+        if saved is not None:
+            return saved
+        if _current(store, snapshot.session_key, sid) is None:
+            return False
+        row = conn.execute('SELECT end_reason FROM sessions WHERE id=?', (sid,)).fetchone()
+        if row is None or row[0] is not None:
+            return False
+        if commit_guard is not None:
+            try:
+                if commit_guard() is not True:
+                    return False
+            except Exception:
+                return False
+        _insert(db, conn, sid, message_id, text, observed=True)
+        return True
+    try:
+        return db._execute_write(write, patience_s=0.25)
+    except Exception:
+        try:
+            # A failed rollback may leave a live writer transaction. A separate reader
+            # seeing no row cannot prove that this transaction will never commit later.
+            with db._lock:
+                if db._conn is None or db._conn.in_transaction:
+                    raise UnsettledObservation("ingress writer has not settled")
+            with db._read_ctx() as conn:
+                return _existing(conn, sid, message_id) is True
+        except Exception:
+            raise UnsettledObservation('ingress observation settlement unavailable') from None
+
+
+def recover_input(db, sid, message_id, text, timestamp):
+    """Existing shutdown-spool replay; a committed observation wins over its recovery copy."""
+    if not message_id:
+        raise ValueError('ingress recovery requires a stable message ID')
+    def write(conn):
+        if _existing(conn, sid, message_id) is not None:
+            return
+        _insert(db, conn, sid, message_id, text, observed=False, timestamp=timestamp)
+    db._execute_write(write)
